{{- /* Índice para a busca do topo: um item por caso. */ -}}
{{- $itens := slice -}}
{{- range where site.RegularPages "Section" "in" (slice "nova-republica" "internacional") -}}
  {{- $p := partial "partes.html" . -}}
  {{- $ficha := slice -}}
  {{- range .Params.ficha }}{{ $ficha = $ficha | append (print .valor) }}{{ end -}}
  {{- range partial "envolvidos.html" .File.ContentBaseName }}{{ $ficha = $ficha | append .nome }}{{ end -}}
  {{- $itens = $itens | append (dict
      "t" $p.caso
      "s" $p.sub
      "d" .Description
      "u" .RelPermalink
      "sec" .CurrentSection.Title
      "k" .Section
      "per" (.Params.periodo | default "")
      "img" (cond (isset .Params "image") (print "img/thumbs/" .Params.image | relURL) "")
      "f" (delimit $ficha " ")
  ) -}}
{{- end -}}
{{- range partialCached "pessoas.html" "p" -}}
  {{- $cs := slice }}{{ range .casos }}{{ $cs = $cs | append .nome }}{{ end -}}
  {{- $itens = $itens | append (dict "t" .nome "s" (delimit $cs ", ") "d" .desc "u" (print ("pessoas/" | relURL) "#" .id) "sec" "Pessoa" "k" "pessoa" "per" "" "img" "" "f" "") -}}
{{- end -}}
{{- $itens | jsonify -}}
